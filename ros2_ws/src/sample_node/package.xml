<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sample_node</name>
  <version>0.0.0</version>
  <description>ROS 2 Real-Time Performance Evaluation Sample Apps</description>
  <maintainer email="s-watai@esol.co.jp">Satoshi Watai</maintainer>
  <maintainer email="k-yokoyama@esol.co.jp">Koichiro Yokoyama</maintainer>
  <maintainer email="m-iwashita@esol.co.jp">Makoto Iwashita</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_realtime</depend>
  <depend>sensor_msgs</depend>
  <depend>sample_messages</depend>
  <depend>callback_isolated_executor</depend>

  <exec_depend>tracetools_launch</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>stress-ng</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
